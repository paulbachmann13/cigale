{
  "name": "cigale",
  "private": true,
  "version": "1.2.2",
  "description": "Cigale — éditeur PDF local et gratuit (PWA)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite",
    "build": "node scripts/copy-pdfjs-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "fixtures": "node --experimental-strip-types scripts/make-fixtures.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "tauri": "tauri",
    "build:mac": "tauri build --target universal-apple-darwin"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@vite-pwa/assets-generator": "2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
