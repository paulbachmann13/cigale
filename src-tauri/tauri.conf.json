{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cigale",
  "version": "1.3.1",
  "identifier": "fr.cigale.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cigale",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Éditeur PDF local et gratuit",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Document PDF",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5OUVFMDIyRDI5MDBFRkIKUldUN0RwRFNJdUNlQ2Z2UWU5bEZ2d3A0aG9aTEtpYkRPTkRaRVovUGV2MElOS1ZxWWY1Tm80UTQK",
      "endpoints": [
        "https://github.com/paulbachmann13/cigale/releases/latest/download/latest.json"
      ]
    }
  }
}
