{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cigale",
  "version": "1.0.0",
  "identifier": "fr.cigale.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cigale",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Éditeur PDF local et gratuit",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Document PDF",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ]
  }
}
